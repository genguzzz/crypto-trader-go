  "log_turn24": "ln(max(sum quote of bars t-23..t, 1))",
  "off": "side * (X - close[t]) / ATR  (how far the close already is back from the 3-bar extreme)",
  "ext": "side * (X - EMA20) / ATR"
 },
 "transform": "u = piecewise-linear interpolation of x on the 21 cutpoints -> values 0,0.05,...,1 (clamped to [0,1] outside), then u - 0.5; missing x -> 0. z = intercept + sum(coef_k * u_k); p = 1/(1+exp(-z)).",
 "labels": {
  "tail2": "within the next 24 1H bars, price trades >= 2 ATR beyond the 3-bar extreme (top: high >= X + 2*ATR; bottom: low <= X - 2*ATR)",
  "big3": "within the next 24 1H bars, max(high) - close >= 3 ATR or close - min(low) >= 3 ATR"
