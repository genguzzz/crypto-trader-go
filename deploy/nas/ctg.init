#!/bin/sh /etc/rc.common
# procd service for the OKX recorder/scanner on the home NAS (iStoreOS).
# Install: scp to /etc/init.d/ctg, chmod +x, /etc/init.d/ctg enable && /etc/init.d/ctg start
# Outbound goes through the local OpenClash HTTP port; its credential is read from uci at start
# and passed only via the process environment (never written to disk by this script).
# Prerequisite: OpenClash must route okx.com via a proxy node (its DNS maps www.okx.com to a
# link-local address that matches GeoIP/lan → DIRECT and fails). See docs/operations.md.
START=99
USE_PROCD=1
BASE=/mnt/usb1_2-1/Configs/ctg

start_service() {
	local u p auth
	u=$(uci -q get "openclash.@authentication[0].username")
	p=$(uci -q get "openclash.@authentication[0].password")
	[ -f "$BASE/auth" ] && auth=$(cat "$BASE/auth")
	procd_open_instance
	procd_set_param command "$BASE/ctg" -addr 0.0.0.0:8686 -db "$BASE/data/ctg.db"
	procd_set_param env CTG_PROXY="http://$u:$p@127.0.0.1:7890" CTG_AUTH="$auth" GOMEMLIMIT=160MiB GOGC=50
	procd_set_param respawn 3600 10 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
